#!/bin/bash

# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║                   SKETCHYBAR - CATPPUCCIN MOCHA EDITION                   ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

source "$CONFIG_DIR/colors.sh"

PLUGIN_DIR="$CONFIG_DIR/plugins"
ITEM_DIR="$CONFIG_DIR/items"

FONT="Hack Nerd Font Mono"
PADDINGS=3

# ══════════════════════════════════════════════════════════════════════════════
# BAR APPEARANCE
# ══════════════════════════════════════════════════════════════════════════════

bar=(
    height=40
    color=$BAR_COLOR
    border_width=2
    border_color=$BORDER_COLOR
    shadow=on
    position=top
    sticky=on
    show_in_fullscreen=on
    padding_right=10
    padding_left=10
    y_offset=5
    margin=10
    corner_radius=12
    blur_radius=30
)

sketchybar --bar "${bar[@]}"

# The built-in display's notch hides whatever is drawn under it, and left and right items
# ignore it. plugins/notch.sh measures it (its size in points follows the display scaling)
# for notch_width, which places e items right of the notch, and records where the notch
# starts, so plugins/aerospace.sh drops workspace app icons before the left side reaches it.
sketchybar --add item notch left \
           --set notch drawing=off updates=on script="$PLUGIN_DIR/notch.sh" \
           --subscribe notch display_change system_woke

# ══════════════════════════════════════════════════════════════════════════════
# DEFAULT VALUES
# ══════════════════════════════════════════════════════════════════════════════

defaults=(
    icon.font="$FONT:Bold:14.0"
    icon.color=$ICON_COLOR
    icon.padding_left=8
    icon.padding_right=4
    # Hack Nerd Font comes in Regular and Bold only: a missing weight falls back to the
    # system font, which has no Nerd Font glyphs
    label.font="$FONT:Bold:13.0"
    label.color=$LABEL_COLOR
    label.padding_left=4
    label.padding_right=8
    padding_right=4
    padding_left=4
    background.height=28
    background.corner_radius=8
    background.border_width=1
    background.padding_left=4
    background.padding_right=4
    popup.background.border_width=2
    popup.background.corner_radius=8
    popup.background.border_color=$POPUP_BORDER_COLOR
    popup.background.color=$POPUP_BACKGROUND_COLOR
    popup.blur_radius=20
    popup.background.shadow.drawing=on
)

sketchybar --default "${defaults[@]}"

# ══════════════════════════════════════════════════════════════════════════════
# LEFT SIDE - WORKSPACES
# ══════════════════════════════════════════════════════════════════════════════

# Hidden while no Straw Boss GUI server runs
source "$ITEM_DIR/net.sh"
source "$ITEM_DIR/mode_indicator.sh"
source "$ITEM_DIR/spaces.sh"

# ══════════════════════════════════════════════════════════════════════════════
# RIGHT SIDE - SYSTEM INFO
# ══════════════════════════════════════════════════════════════════════════════

# Right-side items are added right to left
source "$ITEM_DIR/calendar.sh"
source "$ITEM_DIR/volume.sh"
source "$ITEM_DIR/battery.sh"
source "$ITEM_DIR/input.sh"
source "$ITEM_DIR/status.sh"
# In the status pill's popup
source "$ITEM_DIR/system_stats.sh"
source "$ITEM_DIR/temperature.sh"
source "$ITEM_DIR/network.sh"
# Right of the notch, growing away from it; shown only while something plays
source "$ITEM_DIR/media.sh"

# ══════════════════════════════════════════════════════════════════════════════
# FINALIZE
# ══════════════════════════════════════════════════════════════════════════════

sketchybar --update
