#!/usr/bin/env bash

set -euo pipefail

# JankyBorders configuration
# Active color theme; themes live in themes/ (cyberpunk is archived there)
THEME="catppuccin-mocha"

# shellcheck disable=SC1090
source "$(dirname "${BASH_SOURCE[0]}")/themes/$THEME.sh"

options=(
    style=round
    width=2.0
    hidpi=off
    order=above
    active_color="$BORDER_ACTIVE_COLOR"
    inactive_color="$BORDER_INACTIVE_COLOR"
)

borders "${options[@]}"
