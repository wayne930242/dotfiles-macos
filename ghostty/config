# Ghostty 配置檔
# 位置: dotfiles-macos/ghostty/config → symlink 到 ~/.config/ghostty/config
#
# 架構：Ghostty 只是 herdr 的宿主 surface，不管 tab/split/多視窗。command 直接
# 開進 herdr（單一 persistent session），herdr 自己畫 workspace/tab/pane，
# macOS 層級只會看到一個 NSWindow，AeroSpace 從根源不會誤判。
#
# 之前試過的路都放棄了：tmux 當 multiplexer（command 轉發 tmux prefix）跟
# AeroSpace+SketchyBar+Hammerspoon 自製 tab bar，都是因為「Ghostty 原生 tab
# 底層是各自獨立 NSWindow，AeroSpace 一定誤判平鋪」在打補丁，herdr 這個方案
# 直接讓多視窗這件事不存在，不用再繞。
#
# 快速鍵刻意不自訂：試過用 native-shortcuts-herd 把 CMD 系列快速鍵轉譯成
# herdr escape sequence，結果它寫出的設定值（例如 new_tab = "t"，沒有
# literal 的 "prefix+" 字首）違反 herdr 自己「prefix-first，避免直接綁定
# 攔截打字」的安全原則，被 herdr 的設定驗證直接停用，CMD+T 等一整組都失效。
# 已用 native-shortcuts-herd 官方 uninstall 指令拆乾淨，改成全部用 herdr
# 原生的 Ctrl+B prefix 手感（tab/workspace/pane 操作見 herdr --default-config
# 或 herdr --skill），不引入額外轉譯層。

# ============================================
# 外觀設定 (對齊 .wezterm.lua)
# ============================================

font-family = "MesloLGS NF"
font-family = "PingFang TC"
font-family = "Heiti TC"
# 台、客語缺字備援（安裝：brew install --cask font-iansui）
font-family = "Iansui"
font-size = 14

theme = "Dracula"

# herdr 官方建議的宿主設定：滿版、無邊距，因為畫面內容（tab/pane 邊框、
# sidebar）全部由 herdr 自己畫
window-padding-x = 0
window-padding-y = 0
maximize = true

# 完全關閉視窗裝飾，包含原生 tab toolbar，讓 macOS 層級只看到一個 NSWindow
# （原因見檔案開頭架構說明）
window-decoration = none

# herdr 是唯一會在這個 surface 裡跑的程式：單一 persistent session，
# tab/workspace/pane 全部在 herdr 內部管理，不會產生新的 NSWindow
command = /opt/homebrew/bin/herdr

# Option 鍵當 Alt，讓終端機序列（例如 alt+左右移動游標）正常運作，
# 對應 wezterm 的 send_composed_key_when_*_alt_is_pressed = false
macos-option-as-alt = true

cursor-style = bar
cursor-style-blink = true

# shell-integration 預設會依 prompt 狀態改游標樣式，herdr 自己也在管游標，
# 兩邊搶著畫容易互相蓋掉（社群設定 SergioDiez/SergioDiez 的 ghostty config
# 也是這樣做）
shell-integration-features = no-cursor

# 半透明背景，僅為了 quick terminal 才開（原本 theme_contract.sh 鎖住不透明
# 的決定已經跟使用者確認推翻，一般視窗也會一起半透明，Ghostty 沒有 per-surface
# 設定可以只套用在 quick terminal 上）
background-opacity = 0.90
background-blur = true

# ============================================
# Quick Terminal（雙擊 CMD 召喚，見 hammerspoon/init.lua）
# ============================================

# Ghostty 不支援「modifier 連按兩下」這種 trigger，雙擊 CMD 的偵測交給
# Hammerspoon 做，偵測到後送出合成按鍵 F19（實體鍵盤通常沒有，不會跟其他
# 快速鍵衝突），這裡用 global keybind 接住它，即使 Ghostty 不是前景 app 也能動作
quick-terminal-position = top
keybind = global:f19=toggle_quick_terminal

# Ghostty 內建的原生 split/tab 快速鍵（CMD+D 系列、CMD+[ ]、CMD+OPT+方向鍵、
# CMD+CTRL+方向鍵）預設是活的，沒被覆蓋掉的話會在 Ghostty 這層再切一個
# split／再開一個原生 tab，裡面又跑一個 herdr client 接去同一個 session，
# 直接跟 herdr 自己的 pane 系統打架，全部明確 unbind（這不是快速鍵客製化，
# 是避免衝突的結構性修正，split/tab/rename 全部交給 herdr 自己的 Ctrl+B
# prefix 處理）。
keybind = super+d=unbind
keybind = super+shift+d=unbind
keybind = super+[=unbind
keybind = super+]=unbind
keybind = super+alt+arrow_up=unbind
keybind = super+alt+arrow_down=unbind
keybind = super+alt+arrow_left=unbind
keybind = super+alt+arrow_right=unbind
keybind = super+ctrl+arrow_up=unbind
keybind = super+ctrl+arrow_down=unbind
keybind = super+ctrl+arrow_left=unbind
keybind = super+ctrl+arrow_right=unbind
keybind = super+ctrl+==unbind
keybind = super+shift+enter=unbind
keybind = super+shift+[=unbind
keybind = super+shift+]=unbind
keybind = super+alt+w=unbind

